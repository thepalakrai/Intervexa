# Copy this file to .env and fill in your real values.
# Never commit the real .env file.

# --- Microsoft Foundry / Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://virexa-budget.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=your-foundry-api-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
# Optional: Foundry project endpoint (portal -> project -> Overview).
# When set, it is shown in /foundry/deployment alongside the model endpoint.
AZURE_FOUNDRY_PROJECT_ENDPOINT=

# --- Azure Key Vault (recommended for production) ---
# When set, secrets resolve from Key Vault (Managed Identity / az login),
# with .env / App Settings as fallback. When empty, the app runs on .env.
# Secret names use dashes, e.g. AZURE_OPENAI_API_KEY -> "AZURE-OPENAI-API-KEY".
AZURE_KEY_VAULT_URL=

# --- Azure Blob Storage ---
AZURE_STORAGE_CONNECTION_STRING=your-blob-connection-string-here
BLOB_CONTAINER_RESUMES=resumes
BLOB_CONTAINER_JDS=job-descriptions

# --- Azure Cosmos DB ---
COSMOS_ENDPOINT=your-cosmos-endpoint-here
COSMOS_KEY=your-cosmos-key-here
COSMOS_DATABASE=virexa
COSMOS_CONTAINER_SESSIONS=sessions
COSMOS_CONTAINER_EVALUATIONS=evaluations
COSMOS_CONTAINER_QUESTIONS=questions

# --- Azure AI Search (question bank) ---
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX=virexa-question-bank

# --- Azure Speech ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia

# --- Question curation (admin) ---
# Comma-separated allowlist for /admin/* writes + generation.
# When empty, any logged-in user may curate (dev convenience only).
ADMIN_EMAILS=you@example.com
